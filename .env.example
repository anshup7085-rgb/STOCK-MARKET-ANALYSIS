# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# CLAUDE.md rule: no passwords, OTPs, PINs, API secrets or private keys in plain text.
# Only the API KEY and the daily ACCESS TOKEN belong here. Your API *secret* is used
# once in the manual token exchange (see SETUP.md) and is not stored by this project.

MARKET_PROVIDER=yfinance          # yfinance | groww | kite | mock

# --- Groww (optional) -----------------------------------------------------
# Mint the access token YOURSELF (see SETUP.md 3b) and paste it here.
# Never store a TOTP seed — the provider refuses to start if GROWW_TOTP_SECRET
# is present, because storing it defeats two-factor authentication.
# GROWW_ACCESS_TOKEN=

# --- Kite Connect (optional) ---------------------------------------------
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=              # regenerate daily; expires each morning

# --- Risk parameters ------------------------------------------------------
# Leave ACCOUNT_EQUITY unset to get sizing formulas instead of rupee amounts.
# ACCOUNT_EQUITY=
RISK_PER_TRADE_PCT=1.0            # max % of equity risked per trade
MAX_PORTFOLIO_RISK_PCT=5.0        # aggregate open risk ceiling
MAX_SINGLE_POSITION_PCT=20.0      # concentration cap

# --- Trading system (see TRADING.md) --------------------------------------
# TRADING_STATE_DIR=state           # books and journals; gitignored
# MAX_OPEN_POSITIONS=5
# MAX_NEW_ENTRIES_PER_CYCLE=3
# DAILY_LOSS_LIMIT_PCT=2.0          # breach engages the kill switch
# MAX_DRAWDOWN_PCT=10.0             # breach engages the kill switch
# MAX_ORDERS_PER_DAY=20
# MAX_ORDERS_PER_SECOND=5           # hard-capped at 5; the exchange threshold is 10
# MIN_NET_RR=2.0
# MAX_HOLD_BARS=20
# LIVE_MAX_RISK_PER_TRADE_PCT=0.25  # live cap, whatever RISK_PER_TRADE_PCT says
#
# Live only. Set these yourself, in the shell that runs the trader — not here.
# LIVE_TRADING_ACK=                 # the exact phrase in TRADING.md
# LIVE_BROKER=kite                  # kite | groww — which account live orders go to
# CHARGE_SCHEDULE=delivery          # fee card for paper: delivery (Zerodha-style) | groww_delivery
# KITE_ALGO_ID=                     # only if Zerodha issues you one
# Never put KITE_TOTP_SECRET, a password or a PIN anywhere: the broker adapter
# refuses to start if it finds one.
