# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# CLAUDE.md rule: no passwords, OTPs, PINs, API secrets or private keys in plain text.
# Only the API KEY and the daily ACCESS TOKEN belong here. Your API *secret* is used
# once in the manual token exchange (see SETUP.md) and is not stored by this project.

MARKET_PROVIDER=yfinance          # yfinance | kite | mock

# --- Kite Connect (optional) ---------------------------------------------
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=              # regenerate daily; expires each morning

# --- Risk parameters ------------------------------------------------------
# Leave ACCOUNT_EQUITY unset to get sizing formulas instead of rupee amounts.
# ACCOUNT_EQUITY=
RISK_PER_TRADE_PCT=1.0            # max % of equity risked per trade
MAX_PORTFOLIO_RISK_PCT=5.0        # aggregate open risk ceiling
MAX_SINGLE_POSITION_PCT=20.0      # concentration cap
